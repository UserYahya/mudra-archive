# The SQLite database, its backups and the generated credential file must never
# be downloadable over HTTP. Require all denied already blocks every request,
# so no php_flag is needed here - and an unguarded php_flag would return 500 on
# a host running PHP through FPM or CGI.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

Options -Indexes
