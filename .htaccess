# Root .htaccess for Mudra Archive (mudra.yahya.bd)
# Cloudflare & SSL optimised, with clean coin URLs and performance headers.

Options -Indexes

DirectoryIndex index.php

# Friendly error pages (soft 404s hurt search rankings).
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set X-Permitted-Cross-Domain-Policies "none"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"

    # Do not advertise the exact PHP version.
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # The admin portal is never indexed.
    <FilesMatch "^(login|logout|dashboard|add-coin|edit-coin|delete-coin)\.php$">
        Header set X-Robots-Tag "noindex, nofollow, noarchive"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Compression - smaller transfers improve Core Web Vitals, which feed rankings
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE application/rss+xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Browser caching for static assets
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType text/css                "access plus 1 month"
    ExpiresByType application/javascript  "access plus 1 month"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresDefault                        "access plus 2 days"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|webp|gif|ico|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Rewrites
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Strip 'www.' to prevent 2nd-level subdomain SSL wildcard errors.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # 2. Cloudflare & native HTTPS enforcement (no redirect loops behind a proxy).
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 3. One canonical homepage: /index.php collapses to /.
    RewriteCond %{THE_REQUEST} \s/+index\.php(\?[^\s]*)?\s [NC]
    RewriteRule ^index\.php$ /%1 [R=301,L,NE]

    # 4. Search engines expect /sitemap.xml at the root.
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # 5. Clean, keyword-bearing coin URLs:
    #    /coin/12-morgan-dollar-united-states-1921 -> coin.php?id=12
    RewriteRule ^coin/([0-9]+)(-[^/]*)?/?$ coin.php?id=$1 [L,QSA]

    # 6. Never serve the local-only quarantine folder.
    RewriteRule ^_private(/|$) - [F,L]
</IfModule>

# ---------------------------------------------------------------------------
# Block direct access to data, configuration and development files
# ---------------------------------------------------------------------------
<FilesMatch "(?i)\.(db|sqlite|sqlite3|sql|log|ini|env|sh|bat|bak|old|zip|tar|gz)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)^(README\.md|composer\.(json|lock)|package(-lock)?\.json|\.git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
