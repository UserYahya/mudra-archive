# ---------------------------------------------------------------------------
# Mudra Archive - never commit collection data, credentials or local material.
# ---------------------------------------------------------------------------

# The SQLite database holds the real collection AND the admin password hash.
# It is created automatically on first run and must never be committed.
database/*.db
database/*.sqlite
database/*.sqlite3
database/*.db-journal
database/*.db-wal
database/*.db-shm
database/*.sql

# The first-run credential file written by includes/db.php.
database/INITIAL_ADMIN_PASSWORD.txt

# Uploaded coin photographs are personal content, not source code.
# The .htaccess in that folder IS source and is force-added below.
assets/uploads/*
!assets/uploads/.htaccess

# Local-only quarantine: stale admin copy, source archive, scratch scripts,
# database backups. Must never reach the web server or a repository.
_private/

# Design mockups and screenshots - not needed to run the site.
stitch-design/

# Backups and archives
*.zip
*.tar
*.tar.gz
*.bak
*.old
*.orig

# Logs and local environment
*.log
.env
.env.*

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
